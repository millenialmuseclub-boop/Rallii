# Leave unset during local development to use file:local.db.
TURSO_DATABASE_URL=libsql://your-database-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Public partner attribution IDs. Add these in Vercel to enable the optional Plan Journey embeds.
NEXT_PUBLIC_STAY22_AID=jordypop
NEXT_PUBLIC_DISCOVERCARS_AID=JordyPop
NEXT_PUBLIC_TRAVELPAYOUTS_TRS=460464
NEXT_PUBLIC_TRAVELPAYOUTS_MARKER=673999

# Native Capacitor OTA settings. These are public, build-time values only.
# The private signing key belongs exclusively in GitHub Actions secrets.
NEXT_PUBLIC_OTA_CHANNEL=production
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=https://pub-9fa41a6ec38e4064b998f30a35df2cb0.r2.dev
